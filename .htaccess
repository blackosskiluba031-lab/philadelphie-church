# .htaccess - Configuration Apache (Laragon local + Render production)
RewriteEngine On
RewriteBase /

# Permet d'acceder aux pages sans .php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# Protection des dossiers sensibles
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
